<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_barcode" model="ir.ui.view">
        <field name="name">account.move.form.inherit.barcode</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='invoice_tab']//field[@name='product_id']" position="before">
                <field name="barcode" string="Barcode/ISBN" readonly="0" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>